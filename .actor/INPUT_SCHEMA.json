{
    "title": "Reputation Auditor Input",
    "type": "object",
    "schemaVersion": 1,
    "properties": {
        "businessType": {
            "title": "What business are we auditing?",
            "type": "string",
            "description": "Example: Dentist, Plumber, Solar",
            "editor": "textfield",
            "prefill": "Solar Energy Company"
        },
        "location": {
            "title": "Where are they located?",
            "type": "string",
            "description": "Example: Atlanta, GA or Miami, FL",
            "editor": "textfield",
            "prefill": "Atlanta, GA"
        }
    },
    "required": ["businessType", "location"]
}
