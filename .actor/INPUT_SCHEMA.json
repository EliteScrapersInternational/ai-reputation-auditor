{
    "title": "Business Lead Generator & Auditor",
    "type": "object",
    "schemaVersion": 1,
    "properties": {
        "businessType": {
            "title": "What kind of business?",
            "type": "string",
            "description": "Example: Plumber, Dentist, Pizza, etc.",
            "editor": "textfield",
            "prefill": "Bakery"
        },
        "location": {
            "title": "What city and state?",
            "type": "string",
            "description": "Example: Chicago, IL or Miami, FL",
            "editor": "textfield",
            "prefill": "Chicago, IL"
        },
        "maxItems": {
            "title": "How many leads do you want?",
            "type": "integer",
            "description": "Maximum number of businesses to find.",
            "default": 20,
            "minimum": 1
        }
    },
    "required": ["businessType", "location"]
}
