{
    "title": "Elite Reputation Auditor Pro",
    "type": "object",
    "schemaVersion": 1,
    "properties": {
        "businessType": {
            "title": "Business Type",
            "type": "string",
            "description": "Example: Dentist, Solar, or Plumber",
            "editor": "textfield",
            "prefill": "Solar Energy Company"
        },
        "location": {
            "title": "Location",
            "type": "string",
            "description": "Example: Miami, FL or Atlanta, GA",
            "editor": "textfield",
            "prefill": "Miami, FL"
        },
        "maxItems": {
            "title": "Max Leads to Scrape",
            "type": "integer",
            "description": "How many businesses do you want to find? (More leads take more time)",
            "minimum": 1,
            "default": 20
        }
    },
    "required": ["businessType", "location", "maxItems"]
}
